{
  "name": "opentwin-synthea",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic Synthea FHIR R4 cohorts and Cohort Studio",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "studio": "tsx studio/src/server.ts",
    "cohort": "tsx studio/src/cli.ts",
    "repro": "tsx studio/src/repro-check.ts",
    "batch": "tsx studio/src/batch-cli.ts",
    "ecg": "tsx signals/src/ecg-cli.ts",
    "eeg": "tsx signals/src/eeg-cli.ts",
    "wearables": "tsx signals/src/wearables-cli.ts",
    "format": "biome check --write",
    "lint": "biome ci",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:generate": "bash generate.test.sh"
  },
  "author": "Open Science Foundation",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
